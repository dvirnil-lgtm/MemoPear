# The Gemini API key is NOT a client variable. It is a secret and must never be
# exposed in the browser bundle, so it lives only in Cloud Functions:
#   firebase functions:secrets:set GEMINI_API_KEY
# For local emulator work, put it in functions/.env (gitignored) as GEMINI_API_KEY.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
# OAuth 2.0 Web client ID for the "Export to Google Sheets" feature
VITE_GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# Web OAuth 2.0 client ID used for NATIVE Google Sign-In in the Android/iOS app
# (Capacitor). Must be the "Web client" from the same Google Cloud project as
# Firebase. If omitted, VITE_GOOGLE_OAUTH_CLIENT_ID is used as a fallback.
VITE_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# HubSpot app Client ID (from developers.hubspot.com, Auth tab) — not secret,
# OAuth client IDs are public by design. The Client Secret goes only into
# Cloud Functions secrets (HUBSPOT_CLIENT_SECRET), never here.
VITE_HUBSPOT_CLIENT_ID=your_hubspot_client_id
# Firebase App Check reCAPTCHA v3 site key (public). Protects the AI Cloud
# Functions from abuse. Create it in Firebase Console → App Check → register the
# web app with the reCAPTCHA v3 provider. If unset, App Check is not initialised.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
# LinkedIn Insight Tag partner id (Campaign Manager). Optional — defaults to the
# production partner id in services/linkedinTracking.ts. Public, not secret.
VITE_LINKEDIN_PARTNER_ID=10575465
