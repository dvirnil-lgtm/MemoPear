rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Blog CMS ---
    // Published posts are world-readable (the public blog + server-side SEO
    // renderer). Drafts and all writes are restricted to owner accounts. Keep
    // this allowlist in sync with BLOG_ADMIN_EMAILS in firebase.ts.
    function isBlogAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['dvir.n.il@gmail.com', 'kleingil777@gmail.com'];
    }
    match /blogPosts/{slug} {
      allow read: if resource.data.status == 'published' || isBlogAdmin();
      allow create, update, delete: if isBlogAdmin();
    }

    match /loginLogs/{doc} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    match /users/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
    match /cancellationRequests/{doc} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // --- Team seats / invitations ---
    // Owner reads their own subscription; a teammate reads the subscription they
    // belong to (verified via their own seatClaim, which only the claimSeat
    // Cloud Function can create). Only the owner writes their own doc directly
    // (seat count / cycle / invite-token rotation); teammate seat claims and
    // removals go through the claimSeat / removeSeatMember Cloud Functions, which
    // run with admin privileges and bypass these rules.
    match /subscriptions/{ownerUid} {
      allow read: if request.auth != null && (
        request.auth.uid == ownerUid ||
        get(/databases/$(database)/documents/seatClaims/$(request.auth.uid)).data.ownerUid == ownerUid
      );
      allow create, update: if request.auth != null && request.auth.uid == ownerUid;
      allow delete: if false;
    }
    // A seatClaim grants Pro access, so no client may forge one — created and
    // deleted only by the seat Cloud Functions. A user may read only their own.
    match /seatClaims/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // --- Cross-device contacts (each user reads/writes only their own) ---
    match /userLeads/{accountId} {
      allow read, write: if request.auth != null && request.auth.uid == accountId;
    }
    match /conferenceSuggestions/{id} {
      // Public read: conference names only, no personal data.
      allow read: if true; // scan-ok: public, non-personal conference names by design
      // Any signed-in user can record a conference name.
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() < 121;
    }
    match /crmConnections/{uid} {
      allow read, write: if false;
    }
  }
}
